<Window x:Class="QuickVoice.KeyWindow" x:ClassModifier="internal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="QuickVoice — chave do Jev" Width="440" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen" Topmost="True"
        FontFamily="Segoe UI Variable Text, Segoe UI" Background="#1C1C1E" Foreground="White">
    <StackPanel Margin="22">
        <TextBlock Text="Cole sua chave da API do Jev" FontSize="16" FontWeight="SemiBold"/>
        <TextBlock Margin="0,8,0,14" TextWrapping="Wrap" Foreground="#B3FFFFFF" FontSize="13">
            Crie uma em console.typesafe.ai. Ela fica só neste PC, criptografada para a sua conta do Windows (DPAPI).
        </TextBlock>
        <PasswordBox x:Name="Field" Height="30" Padding="6,4" FontSize="13" Background="#2C2C2E" Foreground="White"
                     BorderBrush="#3AFFFFFF" CaretBrush="White"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Cancelar" IsCancel="True" Width="90" Height="30" Margin="0,0,8,0"/>
            <Button Content="Salvar" IsDefault="True" Width="90" Height="30" Click="OnSave"/>
        </StackPanel>
    </StackPanel>
</Window>
