<Window x:Class="QuickVoice.BarWindow" x:ClassModifier="internal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="QuickVoice" SizeToContent="WidthAndHeight"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False" ShowActivated="False" ResizeMode="NoResize"
        FontFamily="Segoe UI Variable Text, Segoe UI" Foreground="White"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">
    <Window.Resources>
        <!-- Defaults (dark, yellow); BarWindow.ApplyTheme replaces them from the settings. -->
        <SolidColorBrush x:Key="Fire" Color="#FFD60A"/>
        <SolidColorBrush x:Key="FireInk" Color="Black"/>
        <SolidColorBrush x:Key="Panel" Color="#F5424246"/>
        <SolidColorBrush x:Key="Ink" Color="White"/>
        <SolidColorBrush x:Key="Ink08" Color="#14FFFFFF"/>
        <SolidColorBrush x:Key="Ink14" Color="#24FFFFFF"/>
        <SolidColorBrush x:Key="Ink24" Color="#3DFFFFFF"/>
        <SolidColorBrush x:Key="Ink33" Color="#55FFFFFF"/>
        <SolidColorBrush x:Key="Ink45" Color="#73FFFFFF"/>
        <SolidColorBrush x:Key="Ink50" Color="#80FFFFFF"/>
        <SolidColorBrush x:Key="Ink55" Color="#8CFFFFFF"/>
        <SolidColorBrush x:Key="Ink70" Color="#B3FFFFFF"/>
        <Style x:Key="RoundButton" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource Ink}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Background" Value="{DynamicResource Ink14}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Disc" Width="28" Height="28" CornerRadius="14" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Disc" Property="Background" Value="{DynamicResource Ink24}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Disc" Property="Background" Value="{DynamicResource Ink33}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- Room around the pill for its shadow and for the sway while it is dragged. -->
    <Grid x:Name="Root" Margin="24,30,24,40" Width="520" RenderTransformOrigin="0.5,0.5">
        <Grid.RenderTransform>
            <TransformGroup>
                <ScaleTransform x:Name="Lift"/>
                <RotateTransform x:Name="Tilt"/>
                <TranslateTransform x:Name="Slide"/>
            </TransformGroup>
        </Grid.RenderTransform>
        <!-- Shadow on its own layer so the text above stays crisp. -->
        <Border x:Name="Shadow" CornerRadius="22" Background="{DynamicResource Panel}">
            <Border.Effect>
                <DropShadowEffect BlurRadius="32" ShadowDepth="10" Direction="270" Opacity="0.28" Color="#1E2A3A"/>
            </Border.Effect>
        </Border>
        <Border x:Name="Card" CornerRadius="22" Background="Transparent" BorderBrush="{DynamicResource Ink08}" BorderThickness="1"
                MouseLeftButtonDown="OnDrag">
            <StackPanel>
                <Grid Height="44" Margin="8,0,10,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Paused: a play disc. Listening: the waveform, which pauses when clicked. -->
                    <Button x:Name="ToggleButton" Style="{StaticResource RoundButton}" Click="OnToggle" VerticalAlignment="Center">
                        <Grid>
                            <TextBlock x:Name="ToggleGlyph" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="11" Text="&#xE768;"/>
                            <StackPanel x:Name="Wave" Orientation="Horizontal" Height="16" Visibility="Collapsed">
                                <Rectangle Width="3" Height="14" Margin="0,0,2.5,0" RadiusX="1.5" RadiusY="1.5" Fill="#30D158" RenderTransformOrigin="0.5,0.5"/>
                                <Rectangle Width="3" Height="14" Margin="0,0,2.5,0" RadiusX="1.5" RadiusY="1.5" Fill="#30D158" RenderTransformOrigin="0.5,0.5"/>
                                <Rectangle Width="3" Height="14" Margin="0,0,2.5,0" RadiusX="1.5" RadiusY="1.5" Fill="#30D158" RenderTransformOrigin="0.5,0.5"/>
                                <Rectangle Width="3" Height="14" RadiusX="1.5" RadiusY="1.5" Fill="#30D158" RenderTransformOrigin="0.5,0.5"/>
                            </StackPanel>
                        </Grid>
                    </Button>

                    <TextBlock x:Name="Line" Grid.Column="1" Margin="10,0,8,0" VerticalAlignment="Center" FontSize="15"
                               TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>

                    <!-- Write mode: type a command instead of saying it. -->
                    <Grid x:Name="WriteBox" Grid.Column="1" Margin="10,0,8,0" VerticalAlignment="Center" Visibility="Collapsed">
                        <TextBlock x:Name="InputHint" Text="Escreva um comando…  (Enter executa, Esc cancela)" FontSize="15"
                                   Foreground="{DynamicResource Ink45}" IsHitTestVisible="False" Margin="2,0,0,0"/>
                        <TextBox x:Name="Input" FontSize="15" Foreground="{DynamicResource Ink}" CaretBrush="{DynamicResource Ink}" Background="Transparent"
                                 BorderThickness="0" Padding="0" SelectionBrush="#6630D158"
                                 KeyDown="OnInputKey" TextChanged="OnInputChanged"/>
                    </Grid>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button x:Name="WriteButton" Style="{StaticResource RoundButton}" Background="Transparent" Click="OnWrite"
                                Margin="0,0,4,0">
                            <TextBlock FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="14" Text="&#xE765;" Foreground="{DynamicResource Ink70}"/>
                        </Button>
                        <Border x:Name="HotkeyChip" CornerRadius="11" Height="22" Padding="8,0" Background="{DynamicResource Ink08}" Margin="0,0,4,0">
                            <TextBlock x:Name="HotkeyText" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource Ink50}" VerticalAlignment="Center"/>
                        </Border>
                        <Border x:Name="FireChip" CornerRadius="15" Height="30" Padding="12,0" Background="{DynamicResource Fire}" Visibility="Collapsed"
                                RenderTransformOrigin="0.5,0.5">
                            <Border.RenderTransform>
                                <ScaleTransform x:Name="FireScale"/>
                            </Border.RenderTransform>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Text="&#xE945;" FontSize="12" Foreground="{DynamicResource FireInk}"
                                           VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <TextBlock x:Name="FireText" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource FireInk}" MaxWidth="220"
                                           TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                        <TextBlock x:Name="StateText" FontSize="12" Foreground="{DynamicResource Ink55}" Margin="0,0,9,0" Visibility="Collapsed"/>
                    </StackPanel>
                </Grid>

                <Border x:Name="Tray" BorderBrush="{DynamicResource Ink08}" BorderThickness="0,1,0,0" Visibility="Collapsed">
                    <StackPanel Margin="16,10,16,14">
                        <Grid Margin="0,0,0,9">
                            <TextBlock Text="LEITURA DO JEV" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource Ink50}"/>
                            <TextBlock Text="no meio da frase a 0,80" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource Ink50}" HorizontalAlignment="Right"/>
                        </Grid>
                        <StackPanel x:Name="Meters"/>
                        <WrapPanel x:Name="Tags" MinHeight="26" Margin="0,2,0,0"/>
                        <StackPanel x:Name="Fires"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Border>
    </Grid>
</Window>
