<Window x:Class="QuickVoice.SettingsWindow" x:ClassModifier="internal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="QuickVoice — configurações" Width="520" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen" Topmost="True"
        FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="13" Background="#F7F7F8">
    <Window.Resources>
        <Style x:Key="Heading" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,16,0,6"/>
        </Style>
        <Style x:Key="Hint" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#5F6368"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,4,0,0"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="12,5"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
        </Style>
    </Window.Resources>
    <StackPanel Margin="24,10,24,22">
        <TextBlock Text="Idioma da fala" Style="{StaticResource Heading}"/>
        <ComboBox x:Name="LocaleBox" Height="28">
            <ComboBoxItem Tag="" Content="O mesmo da fala do Windows"/>
            <ComboBoxItem Tag="pt-BR" Content="Português (Brasil)"/>
            <ComboBoxItem Tag="pt-PT" Content="Português (Portugal)"/>
            <ComboBoxItem Tag="en-US" Content="English (US)"/>
            <ComboBoxItem Tag="es-ES" Content="Español"/>
        </ComboBox>

        <TextBlock Text="Reconhecimento de fala" Style="{StaticResource Heading}"/>
        <RadioButton x:Name="WindowsRadio" GroupName="recognizer" Content="Windows (online): o mais rápido, usa o serviço de fala da Microsoft"/>
        <RadioButton x:Name="WhisperRadio" GroupName="recognizer" Margin="0,6,0,0" Content="Whisper (offline): nada sai do seu PC"/>
        <StackPanel Orientation="Horizontal" Margin="22,8,0,0">
            <TextBlock Text="Modelo:" VerticalAlignment="Center" Margin="0,0,8,0"/>
            <ComboBox x:Name="ModelBox" Width="280" Height="26">
                <ComboBoxItem Tag="tiny" Content="tiny · 75 MB · mais rápido"/>
                <ComboBoxItem Tag="base" Content="base · 140 MB · equilibrado"/>
                <ComboBoxItem Tag="small" Content="small · 470 MB · mais preciso"/>
            </ComboBox>
        </StackPanel>
        <TextBlock Style="{StaticResource Hint}" Margin="22,6,0,0"
                   Text="O modelo é baixado uma vez para %LOCALAPPDATA%\QuickVoice\models."/>

        <TextBlock Text="Atalho para ouvir" Style="{StaticResource Heading}"/>
        <ComboBox x:Name="HotkeyBox" Height="28">
            <ComboBoxItem Tag="auto" Content="Automático: Alt+Espaço, ou Ctrl+Alt+Espaço se estiver em uso"/>
            <ComboBoxItem Tag="alt" Content="Alt+Espaço"/>
            <ComboBoxItem Tag="ctrl-alt" Content="Ctrl+Alt+Espaço"/>
            <ComboBoxItem Tag="ctrl-shift" Content="Ctrl+Shift+Espaço"/>
        </ComboBox>

        <TextBlock Text="Palavra de ativação" Style="{StaticResource Heading}"/>
        <CheckBox x:Name="WakeCheck" Content="Sempre ouvindo: age só quando a frase começa com o nome abaixo"/>
        <TextBox x:Name="WakeBox" Margin="22,8,0,0" Height="26" Padding="4,3"/>
        <TextBlock Style="{StaticResource Hint}" Margin="22,6,0,0"
                   Text="Separe variações por vírgula. Ex.: “QuickVoice, abre o chrome”. Com o reconhecimento do Windows, o áudio vai continuamente para a Microsoft; com o Whisper, fica no PC."/>

        <TextBlock Text="Aparência da barra" Style="{StaticResource Heading}"/>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <ComboBox x:Name="ThemeBox" Height="28" ToolTip="Tema">
                <ComboBoxItem Tag="dark" Content="Escuro"/>
                <ComboBoxItem Tag="light" Content="Claro"/>
            </ComboBox>
            <ComboBox x:Name="AccentBox" Grid.Column="2" Height="28" ToolTip="Cor de destaque">
                <ComboBoxItem Tag="yellow" Content="Amarelo"/>
                <ComboBoxItem Tag="blue" Content="Azul"/>
                <ComboBoxItem Tag="green" Content="Verde"/>
                <ComboBoxItem Tag="pink" Content="Rosa"/>
            </ComboBox>
            <ComboBox x:Name="SizeBox" Grid.Column="4" Height="28" ToolTip="Tamanho">
                <ComboBoxItem Tag="small" Content="Pequena"/>
                <ComboBoxItem Tag="normal" Content="Normal"/>
                <ComboBoxItem Tag="large" Content="Grande"/>
            </ComboBox>
        </Grid>
        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
            <TextBlock Text="Brilho da voz:" VerticalAlignment="Center" Margin="0,0,8,0"/>
            <ComboBox x:Name="GlowBox" Width="200" Height="28">
                <ComboBoxItem Tag="colorful" Content="Colorido"/>
                <ComboBoxItem Tag="ocean" Content="Oceano"/>
                <ComboBoxItem Tag="sunset" Content="Pôr do sol"/>
                <ComboBoxItem Tag="forest" Content="Floresta"/>
                <ComboBoxItem Tag="candy" Content="Doce"/>
                <ComboBoxItem Tag="ice" Content="Gelo"/>
                <ComboBoxItem Tag="gold" Content="Dourado"/>
                <ComboBoxItem Tag="mono" Content="Mono"/>
                <ComboBoxItem Tag="off" Content="Desligado"/>
            </ComboBox>
        </StackPanel>

        <TextBlock Text="Atualizações" Style="{StaticResource Heading}"/>
        <CheckBox x:Name="UpdatesCheck" Content="Procurar uma versão nova no GitHub ao iniciar"/>

        <TextBlock Text="Mais" Style="{StaticResource Heading}"/>
        <WrapPanel>
            <Button Content="Agente Copilot…" Click="OnAgent"/>
            <Button Content="Editar meus atalhos…" Click="OnShortcuts"/>
            <Button Content="Chave do Jev…" Click="OnKey"/>
            <Button Content="Pasta de logs" Click="OnLogs"/>
        </WrapPanel>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,22,0,0">
            <Button Content="Cancelar" IsCancel="True" Width="96"/>
            <Button Content="Salvar" IsDefault="True" Width="96" Margin="0" Click="OnSave"/>
        </StackPanel>
    </StackPanel>
</Window>
